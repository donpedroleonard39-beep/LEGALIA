rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function matterDoc(matterId) {
      return get(/databases/$(database)/documents/matters/$(matterId));
    }

    function isMember(matterId) {
      return isSignedIn() &&
        request.auth.uid in matterDoc(matterId).data.members;
    }

    function memberPermission(matterId) {
      return matterDoc(matterId).data.members[request.auth.uid];
    }

    function canEdit(matterId) {
      return isMember(matterId) &&
        memberPermission(matterId) in ['owner', 'editor'];
    }

    function isOwner(matterId) {
      return isMember(matterId) && memberPermission(matterId) == 'owner';
    }

    // ---------- Users ----------
    // Every signed-in user can read any user's public profile (needed to
    // resolve names/emails for matter members, invites, notifications).
    // A user may only ever create or update their OWN document - there is no
    // global role field left to protect, so this is intentionally simple.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- Matters ----------
    match /matters/{matterId} {
      // Only members (owner/editor/viewer) can read a matter. Checked
      // directly against resource.data here (rather than via the isMember()
      // helper, which performs a get() on the matter doc) because
      // fetchAllMatters() runs a collection-wide query - Firestore only
      // allows a list/query read when the rule can be evaluated from the
      // queried document's own fields, not via a get() back on itself.
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      // Anyone signed in can create a matter, but only as themselves: they
      // must be the ownerId, and must appear in members as 'owner'. This is
      // what replaces the old "admin/lawyer/paralegal only" restriction.
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members[request.auth.uid] == 'owner';

      // Editors/owner can update matter fields, but only the owner may
      // change ownerId or edit the members map directly (member changes
      // normally go through the invite-accept flow below, or owner-only
      // removal handled client-side by an owner update).
      allow update: if isOwner(matterId) ||
        (canEdit(matterId) &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.members == resource.data.members);

      allow delete: if isOwner(matterId);

      match /documents/{docId} {
        allow read: if isMember(matterId);
        allow write: if canEdit(matterId);
      }

      match /timeline/{eventId} {
        allow read: if isMember(matterId);
        allow write: if canEdit(matterId);
      }

      // Invites live under the matter they belong to. Only the owner can
      // create or manage them. Anyone signed in may READ a single invite by
      // its id (needed to show "You've been invited to Suit X" before the
      // invitee is a member yet) - the token itself, not Firestore rules, is
      // what keeps invite links unguessable.
      match /invites/{inviteId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(matterId);
        allow update: if isOwner(matterId) || (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'accepted'
        );
      }
    }

    // ---------- Reminders (private, per-user) ----------
    match /reminders/{reminderId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // A reminder can be created or refreshed for yourself, or for any
      // fellow member of a matter you also belong to (covers automatic
      // hearing-date reminders fanned out to every member on save).
      allow create, update: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.matterId is string &&
         isMember(request.resource.data.matterId))
      );
    }

    // ---------- Notifications (private, per-user) ----------
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // A notification can be created for yourself, or for any member of a
      // matter you are also a member of (covers "notify the team" writes).
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.matterId is string &&
         isMember(request.resource.data.matterId))
      );
    }
  }
}
