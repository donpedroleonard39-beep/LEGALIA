rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    match /matters/{matterId} {
      allow read, update: if request.auth != null && (resource == null || request.auth.uid in resource.data.teamMembers);
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (resource == null || request.auth.uid == resource.data.leadLawyer);

      match /documents/{docId} {
        allow read, write, create, delete: if request.auth != null;
      }
      match /timeline/{eventId} {
        allow read, write, create, delete: if request.auth != null;
      }
      match /invites/{inviteId} {
        allow read, write, create, delete: if request.auth != null;
      }
    }

    match /reminders/{reminderId} {
      allow read, write, create, delete: if request.auth != null;
    }

    match /notifications/{notifId} {
      allow read, write, create, delete: if request.auth != null;
    }
  }
}
