rules_version = '2';

// Legalia - Firestore security rules.
//
// Principles:
//  * Nobody can list or browse data they are not part of.
//  * The browser can never ADD someone to a matter, or write reminders /
//    notifications for anyone else. Those actions run on the server
//    (api/*.ts, Firebase Admin SDK), which these rules do not restrict.
//  * Everything not explicitly allowed is denied.
//
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function matterData(matterId) {
      return get(/databases/$(database)/documents/matters/$(matterId)).data;
    }

    function roleIn(matterId) {
      return matterData(matterId).members[request.auth.uid];
    }

    function isMember(matterId) {
      return signedIn() && request.auth.uid in matterData(matterId).members;
    }

    function canEdit(matterId) {
      return isMember(matterId) && roleIn(matterId) in ['owner', 'editor'];
    }

    function isOwner(matterId) {
      return isMember(matterId) && roleIn(matterId) == 'owner'
        && matterData(matterId).ownerId == request.auth.uid;
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- Users ----------
    // A profile can be fetched one at a time by id (to show collaborators'
    // names), but the collection can NOT be listed - no scraping the user base.
    // The email on a profile must be the account's real sign-in email, and it
    // can never be changed from the browser (invitations are matched on it).
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower();

      allow update: if signedIn()
        && request.auth.uid == uid
        && unchanged(['uid', 'email', 'createdAt']);

      allow delete: if false; // account deletion runs on the server
    }

    // ---------- Matters ----------
    match /matters/{matterId} {
      // Query-safe check (evaluated on the document itself).
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // You can only create a matter that you own and that has NO other
      // members. People join through invitations, which the server applies.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner';

      // Owners and editors may edit a matter's details. Membership (adding,
      // removing, changing permissions) and ownership are never editable from
      // the browser - those run on the server, which checks who is asking.
      allow update: if canEdit(matterId)
        && unchanged(['ownerId', 'members', 'createdAt', 'createdBy']);

      // Deleting a matter (and everything under it) runs on the server so
      // that history, invites and files are removed too.
      allow delete: if false;

      match /timeline/{eventId} {
        allow read: if isMember(matterId);
        allow create: if canEdit(matterId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEdit(matterId) && unchanged(['createdBy', 'createdAt']);
        allow delete: if canEdit(matterId);
      }

      match /documents/{docId} {
        allow read: if isMember(matterId);
        allow create: if canEdit(matterId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update: if canEdit(matterId) && unchanged(['uploadedBy', 'storagePath']);
        allow delete: if canEdit(matterId);
      }

      // Shareable invite links. Only the owner can see or manage them; the
      // person opening a link never reads this collection - the server
      // checks the link's secret for them (api/collab-invites.ts).
      match /invites/{inviteId} {
        allow read: if isOwner(matterId);
        allow create: if isOwner(matterId)
          && request.resource.data.status == 'pending'
          && request.resource.data.permission in ['editor', 'viewer']
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 32;
        allow delete: if isOwner(matterId);
        allow update: if false;
      }
    }

    // ---------- Reminders (private, per user) ----------
    // Only your own custom reminders. Automatic hearing reminders are worked
    // out by the server from each matter's hearing date - nobody writes them.
    match /reminders/{reminderId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.fired == false
        && isMember(request.resource.data.matterId)
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
      allow update: if false;
    }

    // ---------- Notifications (private, per user) ----------
    // Created only by the server. You can read, mark read/archived and
    // delete your own - nothing else.
    match /notifications/{notifId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && onlyChanges(['read', 'archived', 'archivedAt']);
      allow create: if false;
    }

    // collabInvites, rateLimits and anything else: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
