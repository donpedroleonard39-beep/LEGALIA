rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // This project's Firestore now uses the (default) database (see
    // firebase-applet-config.json / firebase.json), so firestore.get() below
    // reliably targets it. That resolves the earlier limitation noted in
    // this file's history, where a NAMED Firestore database made a real
    // cross-service membership check unreliable and this fell back to
    // "any signed-in user." Do not reintroduce a named Firestore database
    // without revisiting this rule.
    match /matters/{matterId}/{fileName} {
          allow read: if request.auth != null &&
            request.auth.uid in
              firestore.get(/databases/(default)/documents/matters/$(matterId)).data.members;

          allow write: if request.auth != null &&
            firestore.get(/databases/(default)/documents/matters/$(matterId)).data.members[request.auth.uid]
              in ['owner', 'editor'];
    }
  }
}
