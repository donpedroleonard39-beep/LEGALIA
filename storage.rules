rules_version = '2';

// Legalia - Cloud Storage security rules (matter documents).
// Deploy: Firebase console -> Storage -> Rules -> paste -> Publish.
//
// Files live at matters/{matterId}/{fileName}. Membership is checked against
// the matter in the (default) Firestore database. Do not switch to a named
// Firestore database without updating the paths below.
service firebase.storage {
  match /b/{bucket}/o {

    function members(matterId) {
      return firestore.get(/databases/(default)/documents/matters/$(matterId)).data.members;
    }

    function isMember(matterId) {
      return request.auth != null && request.auth.uid in members(matterId);
    }

    function canEdit(matterId) {
      return isMember(matterId) && members(matterId)[request.auth.uid] in ['owner', 'editor'];
    }

    // Court papers: PDFs, Word files, images and plain text, up to 25 MB.
    function allowedUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*'));
    }

    match /matters/{matterId}/{fileName} {
      allow read: if isMember(matterId);
      allow create, update: if canEdit(matterId) && allowedUpload();
      allow delete: if canEdit(matterId);
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
